datasource db {
  provider = 'postgresql'
  url = env('DATABASE_URL')
}

plugin ts {
  provider = '@core/typescript'
  output = '../src/lib/zenstack/generated'
  lite = true
}

plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model User {
  id                   String @id @deny('update', true)
  // Mirror of auth."user".email, written ONLY server-side by provisioning.
  // Readable by the user themself and by OWNER/ADMIN of an organization the
  // user belongs to; plain members of the same organization get null.
  email                String @unique @deny('update', true) @allow('read', auth() != null && (auth().id == id || memberships?[organization.memberships?[userId == auth().id && (role == OWNER || role == ADMIN)]]))
  name                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  memberships          Membership[]
  createdOrganizations Organization[] @relation("OrganizationOwner")
  createdProjects      Project[] @relation("ProjectCreator")

  @@auth
  // No client-side create: the public.User row is written only by the server
  // (src/lib/provisioning.ts, policy-free client) after Better Auth created
  // the account.
  // Read: yourself, plus people who share an organization with you.
  @@allow('read', auth() != null && (auth().id == id || memberships?[organization.memberships?[userId == auth().id]]))
  @@allow('update', auth() != null && auth().id == id)
}

model Organization {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User @relation("OrganizationOwner", fields: [createdById], references: [id])
  createdById String
  memberships Membership[]
  projects    Project[]

  // No client-side create: a workspace and its first OWNER membership are
  // created together by the server (src/lib/provisioning.ts, policy-free
  // client). Add a server action that does the same if users should be able to
  // create more workspaces.
  @@allow('read', auth() != null && memberships?[userId == auth().id])
  @@allow('update,delete', auth() != null && memberships?[userId == auth().id && role == OWNER])
  // createdById is set once, by the server.
  @@deny('post-update', createdById != before().createdById)
}

model Membership {
  id             String @id @default(cuid())
  role           OrgRole @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  @@unique([organizationId, userId])
  // No create/update through the policy client (and therefore none through
  // /api/model, including upsert, nested writes and $transaction): who belongs
  // to a workspace and with which role is decided only by server code that
  // checks the caller first and then writes with the policy-free client
  // (src/lib/admin-db.ts) — today that is provisioning, which creates the
  // first OWNER. Add invitations / role changes as server actions.
  @@allow('read', auth() != null && organization.memberships?[userId == auth().id])
  // An OWNER can remove other members; nobody removes themself (that could
  // leave a workspace without an owner).
  @@allow('delete', auth() != null && userId != auth().id && organization.memberships?[userId == auth().id && role == OWNER])
}

model Project {
  id             String @id @default(cuid())
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  creator        User @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId      String

  @@allow('read', auth() != null && organization.memberships?[userId == auth().id])
  @@allow('create', auth() != null && creatorId == auth().id && organization.memberships?[userId == auth().id])
  // Any org member can update/delete projects — intentional flat-hierarchy design for this template
  @@allow('update,delete', auth() != null && organization.memberships?[userId == auth().id])
  // A project stays in its workspace and keeps its creator.
  @@deny('post-update', organizationId != before().organizationId || creatorId != before().creatorId)
}
