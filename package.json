{
  "name": "t3-extended-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "bun run scripts/test-e2e.ts",
    "test:e2e:dev": "playwright test --workers=1",
    "test:e2e:pw": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "zen generate --schema zenstack/schema.zmodel --lite",
    "db:seed": "bun run scripts/seed.ts",
    "db:ensure-auth-schema": "bun run scripts/ensure-auth-schema.ts",
    "auth:generate": "better-auth generate --config src/lib/auth.ts --yes --output better-auth.sql",
    "auth:migrate": "better-auth migrate --config src/lib/auth.ts --yes",
    "db:migrate": "zen migrate deploy --schema zenstack/schema.zmodel",
    "db:migrate:dev": "zen migrate dev --schema zenstack/schema.zmodel",
    "postinstall": "bun run scripts/postinstall.ts",
    "db:migrate:status": "zen migrate status --schema zenstack/schema.zmodel",
    "up": "bun run scripts/dev.ts",
    "down": "bun run scripts/stop.ts",
    "dx": "bun run scripts/dx.ts",
    "logs": "bun run scripts/docker-logs.ts",
    "image:build": "bun run scripts/docker-build.ts",
    "remote-control": "bun run scripts/remote-control.ts",
    "test:e2e:report": "bunx playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-table": "^8.21.3",
    "@zenstackhq/orm": "3.4.6",
    "@zenstackhq/plugin-policy": "3.4.6",
    "@zenstackhq/server": "3.4.6",
    "@zenstackhq/tanstack-query": "3.4.6",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.28.11",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@zenstackhq/cli": "3.4.6",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
