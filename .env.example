# Environment variables for T3 Extended Template
# Copy to .env.local and fill in values, or use Doppler: `doppler setup`
#
# For local Docker dev (bun run up), these defaults work out of the box.
# For custom overrides, copy this file: cp .env.example .env.local

NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres@localhost:5432/app
AUTH_DATABASE_URL=postgresql://postgres@localhost:5432/app?options=-csearch_path%3Dauth
AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000/api/auth
PLAYWRIGHT_BASE_URL=http://localhost:3000

# MinIO/S3 object storage (optional — for file uploads and attachments)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=app-storage

# Vercel Blob storage (optional — used for file storage on Vercel deployments)
# When set, Vercel Blob is used instead of MinIO for file storage
BLOB_READ_WRITE_TOKEN=

# Test user (optional — for manual/automated testing)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_NAME=
