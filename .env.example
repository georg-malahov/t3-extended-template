# Environment variables for T3 Extended SaaS Template
# Copy to .env.local and fill in values, or use Doppler: `doppler setup`
#
# For local Docker dev (make dev), these defaults work out of the box.
# For native dev (make dev-local), copy this file: cp .env.example .env.local

NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?options=-csearch_path%3Dauth
AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000/api/auth
PLAYWRIGHT_BASE_URL=http://localhost:3000
