{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(yarn lint)",
      "Bash(yarn typecheck)",
      "Bash(yarn test:unit)",
      "Bash(yarn test:unit:watch)",
      "Bash(yarn test:e2e)",
      "Bash(yarn test:e2e:ui)",
      "Bash(yarn db:generate)",
      "Bash(yarn db:migrate)",
      "Bash(yarn db:seed)",
      "Bash(yarn build)",
      "Bash(yarn dev)",
      "Bash(yarn add *)",
      "Bash(npx shadcn@latest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git merge *)",
      "Bash(git fetch *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(tree *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(python3 *)",
      "Bash(docker exec *)",
      "Bash(docker ps *)",
      "Bash(docker stop *)",
      "Bash(docker volume *)",
      "Bash(docker image *)",
      "Bash(ralphex *)",
      "Bash(bin/ralphex-dk *)",
      "Bash(bash .claude/scripts/ralphex-dk.sh *)",
      "Bash(docker pull ghcr.io/umputun/ralphex:latest)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(docker compose down -v *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lint-on-save.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/docs-reminder.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ralphex@ralphex": true,
    "plannotator@plannotator": true
  }
}
