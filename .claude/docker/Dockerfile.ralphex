# check=skip=SecretsUsedInArgOrEnv
# Custom ralphex image for T3 Extended Template
# Debian-based with PostgreSQL, Playwright Chromium, and all project deps.
# Uses multi-stage: copies ralphex + Claude Code from the official Alpine image
# into a Debian base where Playwright's Chromium works natively.
#
# Build:  docker build -t ralphex-t3 -f .claude/docker/Dockerfile.ralphex .
# Usage:  RALPHEX_IMAGE=ralphex-t3 make ralphex-dk PLAN=docs/plans/xxx.md

# --- Stage 1: extract binaries from official ralphex image ---
FROM ghcr.io/umputun/ralphex:latest AS ralphex-src

# --- Stage 2: Debian-based image with full dev toolchain ---
FROM node:24-bookworm-slim

# System deps: git, make, PostgreSQL, su-exec, dbus (for Chromium)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git make procps curl ca-certificates gnupg lsb-release \
    postgresql postgresql-client \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Yarn (classic v1)
RUN corepack enable && corepack prepare yarn@1.22.22 --activate

# Playwright Chromium with all system deps (install to shared path)
RUN PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers npx playwright install --with-deps chromium \
    && chmod -R o+rx /opt/pw-browsers

# Copy ralphex binary + Claude Code + init system from the official image
COPY --from=ralphex-src /srv/ralphex /srv/ralphex
COPY --from=ralphex-src /usr/local/bin/claude /usr/local/bin/claude
COPY --from=ralphex-src /usr/local/bin/codex /usr/local/bin/codex

# Use official entrypoint, patched for Debian:
#   - dinit shebang → bash (dinit is Alpine-only)
#   - su-exec → gosu (Alpine vs Debian equivalent)
#   - sed -i → sed -i'' (Alpine sed vs GNU sed compatibility already fine)
COPY --from=ralphex-src /init.sh /init.sh
RUN sed -i '1s|.*|#!/bin/bash|' /init.sh \
    && sed -i 's/su-exec/gosu/g' /init.sh \
    && sed -i 's/addgroup -g/addgroup --gid/g' /init.sh \
    && sed -i 's/addgroup app/adduser app/g' /init.sh \
    && sed -i 's/delgroup docker/groupdel docker/g' /init.sh \
    && chmod +x /init.sh

# Use official init script (handles Claude credentials, codex, etc.)
COPY --from=ralphex-src /srv/init.sh /srv/init.sh

# Create app user matching the official image's layout
RUN groupadd -g 999 docker \
    && groupadd -g 1001 app \
    && useradd -m -u 1001 -g app -G docker -s /bin/bash app \
    && mkdir -p /srv /home/app \
    && chown -R app:app /srv /home/app

# PostgreSQL data directory
RUN mkdir -p /run/postgresql /var/lib/postgresql/16/data \
    && chown -R postgres:postgres /run/postgresql /var/lib/postgresql

# Tell Playwright where to find the browser (shared location, not under /root/)
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

# Match official ralphex image defaults (required by /init.sh)
ENV TERM=xterm-color
ENV TIME_ZONE=Europe/Berlin
ENV APP_USER=app
ENV APP_UID=1001
ENV DOCKER_GID=999
ENV USE_BUILTIN_RIPGREP=0
ENV RALPHEX_DOCKER=1

# App env vars — sandbox defaults for local PostgreSQL inside container.
# These are NOT production secrets — they only apply to the ephemeral
# in-container PostgreSQL instance. SecretsUsedInArgOrEnv check is disabled above.
ENV DATABASE_URL="postgresql://postgres@localhost:5432/app"
ENV AUTH_DATABASE_URL="postgresql://postgres@localhost:5432/app?options=-csearch_path%3Dauth"
ENV APP_URL="http://localhost:3000"
ENV AUTH_SECRET="tZWssbPUE8cxF7JwsLxKuiE8lBaWC/eFEB9AUKzEUzA="
ENV BETTER_AUTH_URL="http://localhost:3000/api/auth"

# Pre-install node_modules (rebuild image on package changes: make ralphex-build)
# Install at /workspace so .bin symlinks resolve correctly at runtime
COPY package.json yarn.lock /workspace/
RUN cd /workspace && yarn install --frozen-lockfile \
    && mv /workspace/node_modules /prebuilt_node_modules \
    && rm -f /workspace/package.json /workspace/yarn.lock \
    && chown -R app:app /prebuilt_node_modules

# Append custom init steps to the official init script
COPY .claude/docker/pg-init.sh /srv/pg-init.sh
COPY .claude/docker/app-init.sh /srv/app-init.sh
RUN chmod +x /srv/pg-init.sh /srv/app-init.sh /srv/init.sh \
    && printf '\n# --- T3 extension ---\n/srv/pg-init.sh\n/srv/app-init.sh\n' >> /srv/init.sh

WORKDIR /workspace
ENTRYPOINT ["/init.sh"]
CMD ["/srv/ralphex"]
